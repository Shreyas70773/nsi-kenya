# =============================================================================
# North Star Impex Kenya — environment variables
# Copy to .env.local and fill in real values for local dev.
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://northstarimpex.co.ke
SITE_NAME="North Star Impex Kenya"
CONTACT_EMAIL=info@northstarimpex.co.ke
# NAP: must match the Google Business Profile exactly. Set the NEXT_PUBLIC_
# variant too — client components (header, sticky bar, WhatsApp) only see
# public vars; server-only CONTACT_PHONE covers metadata/schema/email.
CONTACT_PHONE=+254 718 727 334
NEXT_PUBLIC_CONTACT_PHONE=+254 718 727 334
# Optional: divert ONLY the wa.me links to a WhatsApp-registered number
# while the primary line has no WhatsApp (eSIM constraint). Empty = use
# the contact number above.
NEXT_PUBLIC_WHATSAPP_PHONE=

# --- Convex -------------------------------------------------------------------
# Set by `npx convex dev` on first run. Convex docs:
#   https://docs.convex.dev/quickstart/nextjs
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Auth.js (NextAuth v5, admin only) ---------------------------------------
# Generate AUTH_SECRET with: openssl rand -base64 32
# AUTH_URL is your canonical site origin (no trailing slash).
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Comma-separated allowlist. Entries can be full emails (user@example.com)
# or bare domains (example.com). Empty / unset = no filter.
ADMIN_EMAIL_ALLOWLIST=

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
QUOTE_NOTIFICATION_EMAIL=
REFERENCE_CALL_NOTIFICATION_EMAIL=
# Comma-separated list for lead notifications (all journeys). Falls back to
# QUOTE_NOTIFICATION_EMAIL, then CONTACT_EMAIL.
LEAD_NOTIFICATION_EMAILS=

# --- CRM webhook (GC-9) --------------------------------------------------------
# Optional JSON POST per lead (Zoho Bigin via Zoho Flow). Empty = no-op.
LEAD_WEBHOOK_URL=

# --- Google Sheets lead mirror -----------------------------------------------
# Apps Script web-app /exec URL. See APPS-SCRIPT.md for the Code.gs that
# binds it to a sheet. Missing var = mirror is a no-op (Convex still saves).
GSHEETS_WEBHOOK_URL=

# --- Analytics ---------------------------------------------------------------
# Google Tag Manager container (GTM-XXXXXXX). Empty = analytics fully off.
# GA4 + Meta Pixel tags live INSIDE the container, never hard-coded.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=northstarimpex.co.ke

# --- Booking embed (F-6, site-audit page) --------------------------------------
# Calendly/Zoho Bookings embed URL. Empty = embed hidden.
NEXT_PUBLIC_BOOKING_URL=

# --- Spam protection (F-7) -----------------------------------------------------
# reCAPTCHA v3 invisible. Both empty = honeypot-only protection.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=

# --- Research (optional, dev-only) -------------------------------------------
FIRECRAWL_API_KEY=
